{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build 2048",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}/game2048/main.cpp",
                "-o",
                "${workspaceFolder}/game2048/main"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}